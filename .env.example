# Configurações do Banco de Dados
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=redot

# Configurações de Segurança
SECRET_KEY=sua_chave_secreta_muito_segura_aqui_123456789

# Configurações de CORS (URLs do frontend permitidas)
CORS_ORIGINS=https://redot.com.br,http://localhost:3000

# URL da API para o Frontend
VITE_API_URL=https://redot.com.br/api

# Configurações AWS (opcional - se usar S3, SES, etc)
AWS_ACCESS_KEY_ID=sua_aws_access_key
AWS_SECRET_ACCESS_KEY=sua_aws_secret_key
AWS_REGION=sa-east-1

# Configurações de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app

# Ambiente
ENVIRONMENT=production
DEBUG=false

# Node Version para o build
NODE_VERSION=20