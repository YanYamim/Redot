# Build stage
FROM python:3.11-slim as builder

WORKDIR /app

# Instalar dependências do sistema para build
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements e instalar dependências Python no prefixo /install
COPY requirements.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Production stage
FROM python:3.11-slim

WORKDIR /app

# Instalar apenas bibliotecas necessárias para runtime
RUN apt-get update && apt-get install -y \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copiar dependências Python do builder para o ambiente do sistema
COPY --from=builder /install /usr/local

# Copiar código da aplicação
COPY . .

# Ambiente
ENV PYTHONUNBUFFERED=1

# Criar diretório para logs
RUN mkdir -p /app/logs

# Instalar gunicorn para produção (caso não esteja no requirements)
RUN pip install --no-cache-dir gunicorn

# Expor porta do Django/Gunicorn
EXPOSE 8000

# Comando padrão: iniciar Gunicorn com WSGI do Django
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "4", "--threads", "2", "--timeout", "120", "redot.redot.wsgi:application"]